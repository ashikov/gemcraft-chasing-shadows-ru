    "static.3468": {
      "font_id": 255,
      "height": 240,
      "lines": [
        "Самоцветы, вставленные в ловушки, наносят меньше урона,",
        "но их особые эффекты гораздо сильнее."
      ],
      "max_width": 6390,
      "wrap": false
    },
    "static.3469": {
